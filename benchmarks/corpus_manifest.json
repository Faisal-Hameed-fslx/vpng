{
  "$schema": "https://example.invalid/vpng/corpus-manifest.schema.json",
  "manifest_version": 1,
  "updated": "2026-11-12",
  "notes": [
    "Provenance and license are mandatory for every entry.",
    "Dimensions are the NATIVE dimensions; never upscale a small image and count it as 16K evidence.",
    "sha256 is over the canonical pixel buffer (docs/VPNG_SPEC_0_1.md section 7).",
    "This manifest is a scaffold: the corpus itself has not been assembled yet."
  ],
  "categories": [
    { "id": "photographs", "target_count": 200, "description": "Natural photographs, varied lighting and detail." },
    { "id": "anime", "target_count": 100, "description": "Anime and illustration, flat regions plus line art." },
    { "id": "digital_paintings", "target_count": 100, "description": "Digital paintings, soft gradients and texture." },
    { "id": "screenshots", "target_count": 100, "description": "Screenshots, text, and UI chrome." },
    { "id": "renders", "target_count": 100, "description": "3D renders with noise and smooth shading." },
    { "id": "procedural", "target_count": 100, "description": "Procedural textures, tiles, patterns." },
    { "id": "noise", "target_count": 50, "description": "Synthetic uniform random, the worst case for any compressor." }
  ],
  "target_total": 750,
  "resolutions": [512, 1024, 2048, 4096, 8192, 16384],
  "formats_under_test": ["gray8", "gray16", "graya8", "graya16", "rgb8", "rgb16", "rgba8", "rgba16"],
  "images": [
    {
      "id": "synthetic-gradient-64-rgba8",
      "category": "procedural",
      "path": "synthetic/gradient_64x64_rgba8.png",
      "source": "generated by vpng-testkit",
      "license": "CC0-1.0",
      "width": 64,
      "height": 64,
      "pixel_format": "rgba8",
      "sha256": null,
      "notes": "Matches the golden fixture; regenerate deterministically via the testkit."
    },
    {
      "id": "synthetic-noise-256-rgba8",
      "category": "noise",
      "path": "synthetic/noise_256x256_rgba8.png",
      "source": "generated by vpng-testkit (xorshift64*, seed 0xC0FFEE)",
      "license": "CC0-1.0",
      "width": 256,
      "height": 256,
      "pixel_format": "rgba8",
      "sha256": null,
      "notes": "Incompressible reference for the Raw fallback and size ceiling."
    }
  ],
  "baselines": [
    { "tool": "png", "version": null, "settings": "default" },
    { "tool": "webp", "version": null, "settings": "lossless" },
    { "tool": "jxl", "version": null, "settings": "lossless" },
    { "tool": "flif", "version": null, "settings": "lossless", "available": false },
    { "tool": "raw", "version": null, "settings": "no compression" }
  ]
}
