# Rust build output
/target/
# The fuzz crate has its own target directory.
/fuzz/target/
**/*.rs.bk

# Python experiment output
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# The compiled extension an editable `maturin develop` install drops into the
# source tree, and the wheels `maturin build` writes. The extension is built
# from `crates/vpng-python`; the committed artifact is the Rust source.
python/vpng/_vpng.pyd
python/vpng/_vpng.so
python/vpng/_vpng.dylib
/dist/

# Benchmark raw runs (keep manifests and reports, ignore bulk data)
/benchmarks/results/*
!/benchmarks/results/.gitkeep
# The fuzzing report is small and is the milestone's durable fuzz evidence.
!/benchmarks/results/fuzz-mutation-report.json

# Large test corpora (provenance recorded in manifests)
/corpus-data/

# The benchmark's working files: the 16K image is hundreds of megabytes and is
# regenerated by vpng-view-bench, so it is never committed.
/benchmarks/work/

# Editor / OS noise
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
