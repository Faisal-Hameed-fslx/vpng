"""Type stubs for the native VPNG extension.

The extension is compiled from Rust; this file describes its surface for
type checkers. The Python wrapper in ``__init__.py`` adds the exception
hierarchy and the convenience wrappers.
"""

from __future__ import annotations

import os
from typing import Any

__version__: str
FORMAT_VERSION: str
DEFAULT_TILE_SIZE: int
DEFAULT_CACHE_BYTES: int
FORMATS: tuple[str, ...]
CODECS: tuple[int, ...]
CODEC_SETS: tuple[str, ...]

class VpngError(Exception):
    """The base class of every error VPNG raises."""

class Region:
    """A rectangle of canonical pixels."""

    @property
    def data(self) -> bytes: ...
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def x(self) -> int: ...
    @property
    def y(self) -> int: ...
    @property
    def format(self) -> str: ...
    def __len__(self) -> int: ...
    def __bytes__(self) -> bytes: ...

class EncodeResult:
    """What an encode did."""

    @property
    def file_size(self) -> int: ...
    @property
    def tile_count(self) -> int: ...
    @property
    def level_count(self) -> int: ...
    @property
    def format_minor(self) -> int: ...
    @property
    def layer_count(self) -> int: ...
    @property
    def codec_ids(self) -> tuple[int, ...]: ...
    @property
    def compression_ratio(self) -> float: ...
    @property
    def payload_bytes(self) -> int: ...
    @property
    def encode_ms(self) -> int: ...
    @property
    def workers(self) -> int: ...

class DecodeResult:
    """What a decode produced."""

    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def format(self) -> str: ...
    @property
    def file_size(self) -> int: ...
    @property
    def level(self) -> int: ...
    @property
    def written_bytes(self) -> int: ...

class CheckResult:
    """What an integrity check did."""

    @property
    def tiles_checked(self) -> int: ...
    @property
    def payload_bytes(self) -> int: ...
    @property
    def ok(self) -> bool: ...

class CommitResult:
    """What a save did."""

    @property
    def path(self) -> str: ...
    @property
    def file_size(self) -> int: ...
    @property
    def tiles_rewritten(self) -> int: ...
    @property
    def tiles_copied(self) -> int: ...
    @property
    def copied_payload_bytes(self) -> int: ...
    @property
    def rewritten_payload_bytes(self) -> int: ...
    @property
    def preview_levels_dropped(self) -> int: ...
    @property
    def baseline_advanced(self) -> bool: ...
    @property
    def elapsed_ms(self) -> int: ...

class Document:
    """An open ``.vpng`` document."""

    @property
    def path(self) -> str: ...
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def format(self) -> str: ...
    @property
    def tile_count(self) -> int: ...
    @property
    def level_count(self) -> int: ...
    @property
    def is_dirty(self) -> bool: ...
    @property
    def edit_count(self) -> int: ...
    @property
    def dirty_tiles(self) -> int: ...
    @property
    def is_closed(self) -> bool: ...
    def info(self) -> dict[str, Any]: ...
    def read_region(self, x: int, y: int, width: int, height: int) -> Region: ...
    def write_region(
        self,
        pixels: Region | bytes,
        x: int | None = None,
        y: int | None = None,
        width: int | None = None,
        height: int | None = None,
    ) -> None: ...
    def edit(self) -> Transaction: ...
    def undo(self) -> bool: ...
    def redo(self) -> bool: ...
    def commit(self, path: str | os.PathLike[str] | None = None) -> CommitResult: ...
    def close(self) -> None: ...
    def __enter__(self) -> Document: ...
    def __exit__(self, *args: Any) -> None: ...

class Transaction:
    """An open transaction."""

    def write_region(
        self,
        pixels: Region | bytes,
        x: int | None = None,
        y: int | None = None,
        width: int | None = None,
        height: int | None = None,
    ) -> None: ...
    def commit(self, path: str | os.PathLike[str] | None = None) -> CommitResult: ...
    def rollback(self) -> None: ...
    def __enter__(self) -> Transaction: ...
    def __exit__(self, *args: Any) -> None: ...

def encode(
    input: str | os.PathLike[str],
    output: str | os.PathLike[str],
    *,
    lossless: bool = True,
    max_size: int | None = None,
    adaptive_tiles: bool = False,
    pyramid_levels: int = 0,
    codec: str = "auto",
    codec_set: str = "stable",
    tile_size: int = DEFAULT_TILE_SIZE,
    workers: int = 1,
) -> EncodeResult: ...
def encode_pixels(
    pixels: bytes,
    width: int,
    height: int,
    output: str | os.PathLike[str],
    *,
    format: str = "rgba8",
    lossless: bool = True,
    max_size: int | None = None,
    adaptive_tiles: bool = False,
    pyramid_levels: int = 0,
    codec: str = "auto",
    codec_set: str = "stable",
    tile_size: int = DEFAULT_TILE_SIZE,
    workers: int = 1,
) -> EncodeResult: ...
def encode_layers(
    output: str | os.PathLike[str],
    layers: list[dict[str, Any]],
    *,
    format: str = "rgba8",
    tile_size: int = DEFAULT_TILE_SIZE,
    workers: int = 1,
) -> EncodeResult: ...
def decode(
    source: str | os.PathLike[str],
    output: str | os.PathLike[str],
    *,
    level: int = 0,
) -> DecodeResult: ...
def decode_to_bytes(source: str | os.PathLike[str], *, level: int = 0) -> bytes: ...
def decode_region(
    source: str | os.PathLike[str],
    output: str | os.PathLike[str],
    x: int,
    y: int,
    width: int,
    height: int,
) -> DecodeResult: ...
def layers(source: str | os.PathLike[str]) -> list[dict[str, Any]]: ...
def decode_layer(
    source: str | os.PathLike[str],
    output: str | os.PathLike[str],
    layer: int,
) -> DecodeResult: ...
def decode_layer_to_bytes(source: str | os.PathLike[str], layer: int) -> bytes: ...
def composite(source: str | os.PathLike[str], output: str | os.PathLike[str]) -> DecodeResult: ...
def composite_to_bytes(source: str | os.PathLike[str]) -> bytes: ...
def verify(input: str | os.PathLike[str], source: str | os.PathLike[str]) -> bool: ...
def check(source: str | os.PathLike[str]) -> CheckResult: ...
def info(source: str | os.PathLike[str]) -> dict[str, Any]: ...
def open_document(
    source: str | os.PathLike[str],
    *,
    cache_bytes: int = DEFAULT_CACHE_BYTES,
    history_bytes: int = ...,
) -> Document: ...
def pixel_format(name: str) -> str: ...
def _register_exceptions(mapping: dict[str, type[BaseException]]) -> None: ...
